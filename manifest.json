{
  "manifest_version": 3,
  "name": "JDG Clockwork",
  "version": "1.2.0",
  "description": "Live shift HUD, early-exit guard, punctuality alarms and deep attendance analytics for the Just Digital Gurus team portal.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://team.justdigitalgurus.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "JDG Clockwork",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://team.justdigitalgurus.com/*"],
      "js": [
        "src/lib/portal.js",
        "src/content/styles.js",
        "src/content/charts.js",
        "src/content/pump.js",
        "src/content/insights.js",
        "src/content/portal-ui.js",
        "src/content/extras.js",
        "src/content/hud.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
